# ─────────────────────────────────────────────────────────────────────────────
# 三元课堂 · 服务器部署环境变量
# 拷贝到 deploy/.env 后修改，docker-compose 会自动读取
#   cp deploy/.env.example deploy/.env
# 注意：deploy/.env 已被 .gitignore，不会进仓库
# ─────────────────────────────────────────────────────────────────────────────

# ── 端口映射（金麟湾服务器规划，避开 BT-Panel 已占用的 80/443/3000/3306 …） ──
# 对外 nginx（宿主反代的目标）
WEB_PORT=3100
# API 直连备用（绕过 nginx，直接访问 NestJS 用于排查）
API_PORT=3101
# MySQL（仅 127.0.0.1 绑定，外网访问不到，但本机可用 mysql -P 3307 连）
MYSQL_PORT=3307

# ── MySQL 容器初始化参数 ──
# 这套账号密码是给 docker volume 第一次初始化用的；之后改密码请进容器或用 SQL
MYSQL_ROOT_PASSWORD=snyuan_root_change_me_please
MYSQL_DATABASE=snyuan
MYSQL_USER=snyuan
MYSQL_PASSWORD=snyuan_pwd_change_me_please

# ── NestJS server 运行时配置 ──

# 容器内监听端口（不要改，宿主映射用 API_PORT 控制）
PORT=3000

# JWT 签名密钥（启用真账号体系时用）；建议 openssl rand -hex 32 生成
JWT_SECRET=please_change_to_random_64_chars

# WS 鉴权模式：off=任何客户端可连（UniApp 还没接 JWT，演示用 off）
WS_AUTH_MODE=off

# 全站访问码：留空 = 关闭；填了之后所有 Web/平板入口都得带这个码
# 演示给客户时建议关闭
ACCESS_CODE=
ACCESS_CODE_TTL_DAYS=7

# ── 书舟统一登录（OIDC 授权码 + PKCE，后端换码） ──
# 打开前必须先在认证中心登记 client（见 shuzhou-auth/migrations/00007_classroom_client.sql），
# 且 SHUZHOU_AUTH_REDIRECT_URI 要与 iam_client.redirect_uris 逐字符一致（认证中心是精确匹配）。
# 留空或 false → 管理后台不展示统一登录入口，只走账号密码登录。
SHUZHOU_AUTH_ENABLED=false
SHUZHOU_AUTH_ISSUER=https://auth.longdao.top
SHUZHOU_AUTH_CLIENT_ID=shuzhou-classroom
SHUZHOU_AUTH_REDIRECT_URI=https://duoyuan.longdao.top/api/v1/auth/shuzhou/callback
# 登记为 public client 时留空；登记为 confidential 时填认证中心一次性返回的 szc_ 开头密钥
SHUZHOU_AUTH_CLIENT_SECRET=
# 反代未透传 X-Forwarded-Host 时用它兜底回跳地址
PUBLIC_BASE_URL=https://duoyuan.longdao.top
# 管理后台部署位置：线上是同源子路径 /admin，本地联调可填 http://localhost:3004
SHUZHOU_AUTH_ADMIN_BASE=/admin
# 中央 role claim → 课堂本地角色的白名单；未登记的角色统一落到 SHUZHOU_AUTH_DEFAULT_ROLE
SHUZHOU_AUTH_ADMIN_ROLES=sys_admin,platform_admin,school_admin,admin
SHUZHOU_AUTH_TEACHER_ROLES=teacher,edu_teacher,school_teacher
SHUZHOU_AUTH_STUDENT_ROLES=student,edu_student
SHUZHOU_AUTH_DEFAULT_ROLE=teacher

# ── 数据库连接（指向同 compose 网络里的 mysql 服务） ──
# 这里 DATABASE_URL 优先级最高；填了就走真 MySQL，业务表 + admin 真鉴权全启用
# 不填则降级为「内存课堂 + admin/admin 演示登录」模式
DATABASE_URL=mysql://snyuan:snyuan_pwd_change_me_please@mysql:3306/snyuan

# 首次部署建议开 synchronize 让 TypeORM 自动建表；线上稳定后改成 false
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ── AI 模型配置（百炼 / 通义千问，OpenAI 兼容协议） ──
# 不填 AI_API_KEY → 系统继续运行但 AI 板书 / AI 实践会走 mock 占位
AI_PROVIDER=qwen
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.5-plus
AI_VISION_MODEL=qwen3-vl-plus-latest
AI_CODER_MODEL=qwen3-coder-plus
AI_REASONING_MODEL=qwen3.7-max

# ── Web 构建期参数（docker compose build 时注入到大屏 / admin 静态产物里） ──
# 默认留空 → SPA 用 window.location.origin 自动适配当前域名
# （在 https://duoyuan.longdao.top 部署 → API 自动走 https://duoyuan.longdao.top/api/v1）
# 想显式锁定到别的后端时填写下面两条：
VITE_API_BASE=
VITE_WS_URL=

# ── pnpm 镜像源（仅 docker compose build 时使用） ──
# 中国大陆服务器强烈建议设为 npmmirror，否则容器内 pnpm install 很慢
# 国际部署留空即可（走 registry.npmjs.org）
NPM_REGISTRY=https://registry.npmmirror.com/

# ── Alpine apk 仓库镜像（仅 docker compose build 时使用） ──
# 中国大陆服务器必填 aliyun，否则 apk add 阶段会卡几十分钟到无限
# 国际部署留空（走 dl-cdn.alpinelinux.org）
APK_MIRROR=https://mirrors.aliyun.com
