<?xml version="1.0" encoding="utf-8"?>
<!--
  Device Admin policy 声明文件。

  关键 use-policies：
    - limit-password / wipe-data：基础设备管理
    - reset-password：远程重置锁屏密码（教师下发"解锁"时用）
    - watch-login：可监听学生输入错误密码次数
    - force-lock：强制锁屏
    - expire-password：密码过期管理

  仅对 Device Owner 模式（adb dpm set-device-owner）生效。Profile Owner 也行但功能受限。
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-policies>
    <limit-password />
    <watch-login />
    <reset-password />
    <force-lock />
    <wipe-data />
    <expire-password />
    <encrypted-storage />
    <disable-camera />
    <disable-keyguard-features />
  </uses-policies>
</device-admin>
